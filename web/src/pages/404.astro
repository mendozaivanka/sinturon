    <p class="label-mono">404</p>
    <h1 class="text-4xl font-semibold tracking-tight">This page is outside the belt.</h1>
    <p class="max-w-[52ch] text-muted-foreground">
      The link may be old. Try the <a class="link" href="/sinturon/">overview</a>, the
      <a class="link" href="/sinturon/map/">map</a>, or go back to <a class="link" href="/">Ivanka's portfolio</a>.
    </p>
  </section>
</SinturonLayout>

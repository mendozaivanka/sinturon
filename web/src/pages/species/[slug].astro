---
import SinturonLayout from "@/components/sinturon/SinturonLayout.astro";
import WorldMap from "@/components/sinturon/WorldMap.astro";
import LatitudeBelt from "@/components/sinturon/LatitudeBelt.astro";
import { getProduction, getRecords, getSummary } from "@/lib/data";
import { BASIS_LABEL, SPECIES, species as info, fmt, pct, type Species } from "@/lib/sinturon";

export function getStaticPaths() {
  return SPECIES.map((slug) => ({ params: { slug } }));
}

const slug = Astro.params.slug as Species;
const sp = info[slug];
const [records, s, prod] = await Promise.all([getRecords(), getSummary(), getProduction()]);

const idx = records.species.indexOf(slug);
const mine = records.rows.filter((r) => r[1] === idx);
const regions = new Intl.DisplayNames(["en"], { type: "region" });
const country = (cc: string) => {
  try {
    return cc ? (regions.of(cc) ?? cc) : "unknown";
  } catch {
    return cc;
  }
};
function count<K>(xs: K[]): [K, number][] {
  const m = new Map<K, number>();
  for (const x of xs) m.set(x, (m.get(x) ?? 0) + 1);
  return [...m].sort((a, b) => b[1] - a[1]);
}
const byCountry = count(mine.map((r) => r[6])).slice(0, 10);
const byBasis = count(mine.map((r) => records.basis[r[4]]));
const years = mine.map((r) => r[5]).filter((y): y is number => y != null).sort((a, b) => a - b);
const ph = mine.filter((r) => r[6] === "PH").length;

const year = prod.latestYear - 1;
const psdKey = sp.psd === "arabica" ? 1 : sp.psd === "robusta" ? 2 : null;
const producers =
  psdKey == null
    ? []
    : prod.countries
        .map((c) => ({ name: c.name, v: c.series.find(([y]) => y === year)?.[psdKey] ?? 0 }))
        .filter((c) => c.v > 0)
        .sort((a, b) => b.v - a.v);
const others = SPECIES.filter((x) => x !== slug);
---

<SinturonLayout
  title={sp.name}
  current="species"
  description={`${sp.name} (${sp.scientific}): ${fmt(s.counts[slug])} open GBIF records, ${pct(s.insideTropicsPct[slug])} of them between the tropics.`}
>
  <section class="grid gap-4 pt-10">
    <nav aria-label="Species" class="flex flex-wrap gap-2 text-sm">
      {
        SPECIES.map((x) => (
          <a
            href={`/sinturon/species/${x}/`}
            aria-current={x === slug ? "page" : undefined}
            class="inline-flex min-h-11 items-center gap-2 rounded-full border border-border bg-card px-4 font-medium text-muted-foreground aria-[current=page]:text-foreground"
            style={x === slug ? `border-color:${info[x].colour}` : undefined}
          >
            <span class="species-dot" style={`color:${info[x].colour}`} />
            {info[x].name}
          </a>
        ))
      }
    </nav>
    <span class="label-mono">Species · GBIF taxon {sp.gbifKey}</span>
    <h1 class="font-heading text-5xl font-bold tracking-[-0.035em]">{sp.name}</h1>
    <p class="text-lg text-muted-foreground italic">{sp.scientific}</p>
    {sp.naming && <p class="max-w-[62ch] rounded-xl border border-border bg-card p-4 leading-relaxed">{sp.naming}</p>}
    <p class="max-w-[62ch] leading-relaxed text-muted-foreground">{sp.blurb}</p>
    <dl class="grid grid-cols-[repeat(auto-fit,minmax(160px,1fr))] gap-3">
      <div class="rounded-2xl border border-border bg-card p-4">
        <dd class="m-0 font-heading text-3xl font-bold tracking-tight">{fmt(s.counts[slug])}</dd><dt class="label-mono mt-1">records kept</dt>
      </div>
      <div class="rounded-2xl border border-border bg-card p-4">
        <dd class="m-0 font-heading text-3xl font-bold tracking-tight">{pct(s.insideTropicsPct[slug])}</dd><dt class="label-mono mt-1">between the tropics</dt>
      </div>
      <div class="rounded-2xl border border-border bg-card p-4">
        <dd class="m-0 font-heading text-3xl font-bold tracking-tight">{years[0] ?? "–"}–{years.at(-1) ?? ""}</dd><dt class="label-mono mt-1">years recorded</dt>
      </div>
      <div class="rounded-2xl border border-border bg-card p-4">
        <dd class="m-0 font-heading text-3xl font-bold tracking-tight">{ph}</dd><dt class="label-mono mt-1">in the Philippines</dt>
      </div>
    </dl>
  </section>

  <section class="grid gap-3 pt-12" aria-labelledby="where-h">
    <h2 id="where-h" class="font-heading text-3xl font-bold tracking-[-0.025em]">Where it has been recorded</h2>
    <div class="rounded-2xl border border-border bg-card p-3 sm:p-5">
      <WorldMap species={[slug]} rmax={slug === "excelsa" || slug === "liberica" ? 14 : 18} />
    </div>
    <p class="text-[13px] text-muted-foreground">3° cells; circle area ∝ records, scaled to this species' busiest cell.</p>
  </section>

  <section class="flex flex-wrap gap-10 pt-12">
    <div class="min-w-0 flex-[1_1_260px]">
      <h2 class="font-heading text-2xl font-bold tracking-[-0.025em]">By latitude</h2>
      <LatitudeBelt species={[slug]} class="mt-3 max-w-[300px]" />
    </div>
    <div class="min-w-0 flex-[1_1_260px]">
      <h2 class="font-heading text-2xl font-bold tracking-[-0.025em]">Countries with most records</h2>
      <table class="mt-3 w-full text-sm">
        <tbody>
          {
            byCountry.map(([cc, n]) => (
              <tr class="border-b border-border">
                <td class="py-1.5">{country(cc)}</td>
                <td class="py-1.5 text-right font-mono">{fmt(n)}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
      <h3 class="mt-6 font-heading text-xl font-semibold">What the records are</h3>
      <table class="mt-2 w-full text-sm">
        <tbody>
          {
            byBasis.map(([b, n]) => (
              <tr class="border-b border-border">
                <td class="py-1.5">{BASIS_LABEL[b] ?? b}</td>
                <td class="py-1.5 text-right font-mono">{fmt(n)}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <div class="min-w-0 flex-[1_1_260px]">
      <h2 class="font-heading text-2xl font-bold tracking-[-0.025em]">Who grows it (USDA)</h2>
      {
        producers.length ? (
          <>
            <p class="mt-2 text-[13px] text-muted-foreground">
              {sp.name} production, marketing year {year} (USDA estimate), {prod.unit}.
            </p>
            <table class="mt-3 w-full text-sm">
              <tbody>
                {producers.slice(0, 10).map((c) => (
                  <tr class="border-b border-border">
                    <td class="py-1.5">{c.name}</td>
                    <td class="py-1.5 text-right font-mono">{fmt(Math.round(c.v))}</td>
                  </tr>
                ))}
              </tbody>
            </table>
            <p class="mt-2 text-[13px] text-muted-foreground">
              {producers.length} countries report {sp.name.toLowerCase()} production.{" "}
              <a class="link" href="/sinturon/grown/">All producers →</a>
            </p>
          </>
        ) : (
          <p class="mt-2 leading-relaxed text-muted-foreground">
            USDA's production series counts Arabica and Robusta only. {sp.name} is not reported separately, so there are no
            country figures here. The Philippine chapter, <a class="link" href="/sinturon/barako/">Barako</a>, will set
            Philippine Statistics Authority figures for liberica and excelsa beside the records.
          </p>
        )
      }
    </div>
  </section>

  <p class="pt-12 text-sm text-muted-foreground">
    Other coffees:{" "}
    {
      others.map((x, i) => (
        <>
          <a class="link" href={`/sinturon/species/${x}/`}>{info[x].name}</a>
          {i < others.length - 1 ? " · " : ""}
        </>
      ))
    }
  </p>
</SinturonLayout>

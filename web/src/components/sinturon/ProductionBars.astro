---
// USDA PSD green coffee production for one marketing year: one bar per country, Arabica and Robusta stacked
// (Other where PSD reports it). Translucent species colour, no borders, rounded ends.
import { getProduction } from "@/lib/data";
import { species as info } from "@/lib/sinturon";

type Props = { year?: number; top?: number; always?: string[]; class?: string };
const prod = await getProduction();
const { year = prod.latestYear - 1, top = 20, always = ["RP"], class: cls = "" } = Astro.props;

const rows = prod.countries
  .map((c) => {
    const r = c.series.find(([y]) => y === year);
    return r ? { code: c.code, name: c.name, arabica: r[1], robusta: r[2], other: r[3], total: r[4] } : null;
  })
  .filter((r): r is NonNullable<typeof r> => !!r && r.total > 0)
  .sort((a, b) => b.total - a.total);
const ranked = rows.map((r, i) => ({ ...r, rank: i + 1 }));
const shown = ranked.filter((r) => r.rank <= top || always.includes(r.code));
const max = Math.max(...shown.map((r) => r.total));

const ROW = 26, BAR = 16, LABEL = 150, W = 720, NUM = 70;
const H = shown.length * ROW + 4;
const scale = (v: number) => ((W - LABEL - NUM) * v) / max;
const fmt = (v: number) => Math.round(v).toLocaleString("en-US");
const forecast = year >= prod.forecastYear;
---

<figure class={`m-0 ${cls}`}>
  <svg viewBox={`0 0 ${W} ${H}`} class="block h-auto w-full" role="img"
    aria-label={`USDA production estimates for marketing year ${year}, top ${top} countries, in thousands of 60 kg bags. ${shown[0]?.name} leads with ${fmt(shown[0]?.total ?? 0)}.`}>
    <defs>
      {shown.map((r, i) => (
        <clipPath id={`bar-${r.code}`}>
          <rect x={LABEL} y={i * ROW + (ROW - BAR) / 2} width={Math.max(BAR, scale(r.total))} height={BAR} rx={BAR / 2} />
        </clipPath>
      ))}
    </defs>
    {shown.map((r, i) => {
      const y = i * ROW + (ROW - BAR) / 2;
      const a = scale(r.arabica), b = scale(r.robusta), o = scale(r.other);
      return (
        <g>
          <text x={LABEL - 10} y={y + BAR - 3.5} text-anchor="end" font-size="13" fill="var(--foreground)" font-weight={r.code === "RP" ? 700 : 400}>
            {r.rank > top ? `${r.rank}. ` : ""}{r.name}
          </text>
          <g clip-path={`url(#bar-${r.code})`}>
            <rect x={LABEL} y={y} width={a} height={BAR} fill={info.arabica.colour} fill-opacity="0.55"><title>{`${r.name}: Arabica ${fmt(r.arabica)}`}</title></rect>
            <rect x={LABEL + a} y={y} width={b} height={BAR} fill={info.robusta.colour} fill-opacity="0.55"><title>{`${r.name}: Robusta ${fmt(r.robusta)}`}</title></rect>
            {o > 0 && <rect x={LABEL + a + b} y={y} width={o} height={BAR} fill="var(--muted-foreground)" fill-opacity="0.4"><title>{`${r.name}: Other ${fmt(r.other)}`}</title></rect>}
          </g>
          <text x={LABEL + Math.max(BAR, scale(r.total)) + 6} y={y + BAR - 3.5} font-size="11.5" font-family="var(--font-mono)" fill="var(--muted-foreground)">{fmt(r.total)}</text>
        </g>
      );
    })}
  </svg>
  <figcaption class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-[13px] text-muted-foreground">
    <span class="inline-flex items-center gap-1.5"><span class="species-dot" style={`color:${info.arabica.colour}`}></span>Arabica</span>
    <span class="inline-flex items-center gap-1.5"><span class="species-dot" style={`color:${info.robusta.colour}`}></span>Robusta</span>
    <span class="inline-flex items-center gap-1.5"><span class="species-dot" style="color:var(--muted-foreground)"></span>Other</span>
    <span>Marketing year {year}{forecast ? " (USDA forecast)" : " (USDA estimate)"} · {prod.unit} · {prod.source}, release {prod.release}</span>
  </figcaption>
</figure>

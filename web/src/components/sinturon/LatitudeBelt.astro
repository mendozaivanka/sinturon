---
// Latitude histograms, one small panel per species: 5° bands from 70° N (top) to 60° S, bar length = the share of
// that species' records in the band, so a species with 189 records reads as clearly as one with 7,719. Bars are
// translucent species colour with rounded ends and no borders; the tropics band sits behind them.
import { getLatitude } from "@/lib/data";
import { SPECIES, species as info, pct, type Species } from "@/lib/sinturon";

type Props = { species?: Species[]; class?: string };
const { species: list = [...SPECIES], class: cls = "" } = Astro.props;
const lat = await getLatitude();

const TOP = 70, BOTTOM = -60, BAND = 5;
const PW = 220, PH = 300, LEFT = 44, PAD_T = 26, PAD_B = 8;
const plotH = PH - PAD_T - PAD_B;
const yOf = (l: number) => PAD_T + ((TOP - l) / (TOP - BOTTOM)) * plotH;
const bandH = (BAND / (TOP - BOTTOM)) * plotH;
const ticks = [60, 40, 20, 0, -20, -40, -60];
const hemi = (l: number | null) => (l == null ? "–" : `${Math.abs(l).toFixed(1)}° ${l >= 0 ? "N" : "S"}`);
const label = (l: number) => (l === 0 ? "0°" : `${Math.abs(l)}° ${l > 0 ? "N" : "S"}`);

const panels = list.map((s) => {
  const st = lat.species[s];
  const bins = st.bins5.filter((b): b is { from: number; to: number; n: number } => b.from !== "other");
  const share = bins.map((b) => ({ ...b, p: st.n ? b.n / st.n : 0 }));
  const maxP = Math.max(0.01, ...share.map((b) => b.p));
  return { s, st, share, maxP };
});
---

<div class={`grid grid-cols-[repeat(auto-fit,minmax(200px,1fr))] gap-6 ${cls}`}>
  {
    panels.map(({ s, st, share, maxP }) => (
      <figure class="m-0">
        <svg
          viewBox={`0 0 ${PW} ${PH}`}
          class="block h-auto w-full"
          role="img"
          aria-label={`${info[s].name}: ${pct(st.pctInsideTropics)} of ${st.n.toLocaleString("en-US")} records lie between the tropics; northernmost ${hemi(st.north)}, southernmost ${hemi(st.south)}.`}
        >
          <rect x={LEFT} y={yOf(lat.tropicLat)} width={PW - LEFT} height={yOf(-lat.tropicLat) - yOf(lat.tropicLat)} fill="var(--tropics)" />
          <g font-family="var(--font-mono)" font-size="10" fill="var(--muted-foreground)">
            {ticks.map((t) => (
              <g>
                <line x1={LEFT} x2={PW} y1={yOf(t)} y2={yOf(t)} stroke="var(--border)" stroke-width="1" />
                <text x={LEFT - 6} y={yOf(t) + 3.5} text-anchor="end">{label(t)}</text>
              </g>
            ))}
          </g>
          {share.map((b) => {
            const w = ((PW - LEFT - 40) * b.p) / maxP;
            const h = bandH - 1.5;
            return b.n > 0 ? (
              <rect x={LEFT} y={yOf(b.to) + 0.75} width={Math.max(h, w)} height={h} rx={h / 2} fill={info[s].colour} fill-opacity="0.55">
                <title>{`${label(b.from)} to ${label(b.to)}: ${b.n.toLocaleString("en-US")} records (${(b.p * 100).toFixed(1)}%)`}</title>
              </rect>
            ) : null;
          })}
          <text x={LEFT} y="14" font-size="13" font-weight="600" fill="var(--foreground)">{info[s].name}</text>
          <text x={PW} y="14" font-size="11" text-anchor="end" font-family="var(--font-mono)" fill="var(--muted-foreground)">
            {pct(st.pctInsideTropics)} in tropics
          </text>
        </svg>
        <figcaption class="mt-1 text-[13px] text-muted-foreground">
          {st.n.toLocaleString("en-US")} records · median {hemi(st.median)} · {hemi(st.north)} to {hemi(st.south)}
        </figcaption>
      </figure>
    ))
  }
</div>
